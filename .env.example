PORT=8080
HOST=127.0.0.1
RUST_LOG=info

# Gemini (required for real deck workflow — M1)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# MCP server binaries (built with `cargo build --release` in each repo)
MCP_WORKSHEET_PATH=../mcp-servers/worksheet-mcp/target/release/excel-mcp-server
MCP_DOCX_PATH=../mcp-servers/docx-mcp/target/release/docx-mcp-server
MCP_SLIDES_PATH=../mcp-servers/mcp_slides/target/release/slides-mcp-server

# MCP Phase B — morning scenario (M3)
MCP_CALENDAR_PATH=../mcp-servers/mcp-calendar/target/release/mcp-calendar
MCP_EMAIL_PATH=../mcp-servers/mcp-email/target/release/mcp-email
MCP_NEWS_PATH=../mcp-servers/mcp-news/target/release/mcp-news
MCP_WEATHER_PATH=../mcp-servers/mcp-weather/target/release/mcp-weather

# Optional: calendar/email OAuth (or run `mcp-calendar auth google`, `mcp-email auth gmail`)
# GOOGLE_CALENDAR_TOKEN=
# GNEWS_API_KEY=

ARTIFACT_DIR=./artifacts